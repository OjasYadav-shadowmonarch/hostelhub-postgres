# Copy this file to ".env" (same folder as app.py) and edit the values.
# app.py loads it automatically on start-up. Never commit the real .env.

# --- PostgreSQL connection -------------------------------------------
# Option A: one URL. If set, it overrides the PG* values below.
# Special characters in the password must be percent-encoded (@ -> %40).
# DATABASE_URL=postgresql://postgres:************@localhost:5432/roomfinder

# Option B: individual settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=roomfinder
PGUSER=postgres
PGPASSWORD=*******

# --- App ---------------------------------------------------------------
# Signs the login session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=**********

# 1 = auto-reload + debugger (local development only), 0 = off
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
