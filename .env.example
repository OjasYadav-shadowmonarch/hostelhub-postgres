# Copy this file to ".env" (same folder as app.py) and edit the values.
# app.py loads it automatically on start-up. Never commit the real .env.
#
# Generate a new secret before the first run:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- PostgreSQL connection -------------------------------------------
# Option A: one URL. If set, it overrides the PG* values below.
# Special characters in the password must be percent-encoded (@ -> %40).
# DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/roomfinder

# Option B: individual settings
PGHOST=localhost
PGPORT=5432
PGDATABASE=roomfinder
PGUSER=postgres
PGPASSWORD=replace-with-your-database-password

# --- App ---------------------------------------------------------------
# Required. Generate a random value of at least 32 characters.
# The app intentionally refuses to start while this is blank or too short.
SECRET_KEY=

# 1 = auto-reload + debugger (local development only), 0 = off
FLASK_DEBUG=0
HOST=127.0.0.1
PORT=5000

# --- Sessions / proxy --------------------------------------------------
# 12 hours is the absolute session lifetime. Range: 1-168 hours.
SESSION_LIFETIME_HOURS=12

# Set to 1 in production when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Set to 1 only when a trusted reverse proxy supplies X-Forwarded-For,
# X-Forwarded-Proto and X-Forwarded-Host. Leave off for direct connections.
TRUST_PROXY=0

# --- Administrator provisioning ---------------------------------------
# Optional on first boot. When both are set, init_db() creates the admin
# account only if it does not already exist. It never overwrites an
# existing password and never promotes a non-admin account.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Optional demo seeder ---------------------------------------------
# Only needed for the optional local demo loader. Leave blank in
# production. The helper refuses to run without this value.
#
#   $env:DEMO_PASSWORD="choose-a-local-password"
#   $env:ADMIN_USERNAME="admin"
#   $env:ADMIN_PASSWORD="choose-a-local-admin-password"
#   python seed_demo.py --reset
#
# This is destructive and must never be run against production.
DEMO_PASSWORD=
